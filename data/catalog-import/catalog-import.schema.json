{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rescened.com/schemas/catalog-import/1.0.0.json",
  "title": "Rescened ListenBrainz catalog import dataset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "datasetId",
    "generatedAt",
    "selection",
    "sourceLicenses",
    "albums"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "datasetId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "generatedAt": {
      "$ref": "#/definitions/isoTimestamp"
    },
    "selection": {
      "$ref": "#/definitions/selection"
    },
    "sourceLicenses": {
      "$ref": "#/definitions/sourceLicenses"
    },
    "albums": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "$ref": "#/definitions/album"
      }
    }
  },
  "definitions": {
    "mbid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "isoTimestamp": {
      "type": "string",
      "minLength": 20,
      "maxLength": 30,
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,3})?Z$"
    },
    "calendarDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])$"
    },
    "nullableCalendarDate": {
      "anyOf": [
        {
          "$ref": "#/definitions/calendarDate"
        },
        {
          "type": "null"
        }
      ]
    },
    "httpsUrl": {
      "type": "string",
      "minLength": 9,
      "maxLength": 2048,
      "pattern": "^https://[^\\s]+$"
    },
    "rangeName": {
      "enum": [
        "all_time",
        "year",
        "month"
      ]
    },
    "selectionRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "range",
        "quota",
        "candidateLimit",
        "from",
        "to",
        "fetchedAt"
      ],
      "properties": {
        "range": {
          "$ref": "#/definitions/rangeName"
        },
        "quota": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000
        },
        "candidateLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "from": {
          "$ref": "#/definitions/nullableCalendarDate"
        },
        "to": {
          "$ref": "#/definitions/nullableCalendarDate"
        },
        "fetchedAt": {
          "$ref": "#/definitions/isoTimestamp"
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetAlbumCount",
        "maxPerPrimaryArtist",
        "ranges"
      ],
      "properties": {
        "targetAlbumCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000
        },
        "maxPerPrimaryArtist": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "ranges": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/definitions/selectionRange"
          }
        }
      }
    },
    "cc0SourceLicense": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "license",
        "url"
      ],
      "properties": {
        "license": {
          "const": "CC0-1.0"
        },
        "url": {
          "$ref": "#/definitions/httpsUrl"
        }
      }
    },
    "coverArtArchiveLicense": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "license",
        "url",
        "notice"
      ],
      "properties": {
        "license": {
          "const": "varies-by-image"
        },
        "url": {
          "$ref": "#/definitions/httpsUrl"
        },
        "notice": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "sourceLicenses": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "listenbrainz",
        "musicbrainz",
        "coverArtArchive"
      ],
      "properties": {
        "listenbrainz": {
          "$ref": "#/definitions/cc0SourceLicense"
        },
        "musicbrainz": {
          "$ref": "#/definitions/cc0SourceLicense"
        },
        "coverArtArchive": {
          "$ref": "#/definitions/coverArtArchiveLicense"
        }
      }
    },
    "selectionSignal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "range",
        "rank",
        "listenCount"
      ],
      "properties": {
        "range": {
          "$ref": "#/definitions/rangeName"
        },
        "rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "listenCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "artistCredit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artistMbid",
        "name",
        "joinPhrase"
      ],
      "properties": {
        "artistMbid": {
          "$ref": "#/definitions/mbid"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "joinPhrase": {
          "type": "string",
          "maxLength": 32
        },
        "artistName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "cover": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "releaseMbid",
        "imageId",
        "url500"
      ],
      "properties": {
        "releaseMbid": {
          "$ref": "#/definitions/mbid"
        },
        "imageId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "url500": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^https://coverartarchive\\.org/release/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/front-500$"
        }
      }
    },
    "sourceFetchedAt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "listenbrainz",
        "musicbrainz"
      ],
      "properties": {
        "listenbrainz": {
          "$ref": "#/definitions/isoTimestamp"
        },
        "musicbrainz": {
          "$ref": "#/definitions/isoTimestamp"
        }
      }
    },
    "album": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "releaseGroupMbid",
        "representativeReleaseMbid",
        "selectedRange",
        "selectionSignals",
        "title",
        "artistDisplayName",
        "artistCredits",
        "releaseType",
        "releaseDate",
        "releaseDatePrecision",
        "releaseYear",
        "cover",
        "sourceFetchedAt"
      ],
      "properties": {
        "releaseGroupMbid": {
          "$ref": "#/definitions/mbid"
        },
        "representativeReleaseMbid": {
          "anyOf": [
            {
              "$ref": "#/definitions/mbid"
            },
            {
              "type": "null"
            }
          ]
        },
        "selectedRange": {
          "$ref": "#/definitions/rangeName"
        },
        "selectionSignals": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3000,
          "items": {
            "$ref": "#/definitions/selectionSignal"
          }
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "artistDisplayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "artistCredits": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/definitions/artistCredit"
          }
        },
        "releaseType": {
          "enum": [
            "album",
            "ep",
            "single",
            "mixtape",
            "soundtrack",
            "compilation",
            "live",
            "remix",
            "other"
          ]
        },
        "releaseDate": {
          "type": "string",
          "pattern": "^(?:|[0-9]{4}(?:-(?:0[1-9]|1[0-2])(?:-(?:0[1-9]|[12][0-9]|3[01]))?)?)$"
        },
        "releaseDatePrecision": {
          "enum": [
            "",
            "year",
            "month",
            "day"
          ]
        },
        "releaseYear": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9999
        },
        "cover": {
          "anyOf": [
            {
              "$ref": "#/definitions/cover"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceFetchedAt": {
          "$ref": "#/definitions/sourceFetchedAt"
        }
      }
    }
  }
}
