# Listening-study: allow only the public, reviewed inputs below. Everything else here
# (captures, private evidence, the local reviewed mapping registry) stays ignored.
!data/listening-study/
data/listening-study/*
!data/listening-study/references.json
!data/listening-study/references.json.sha256
!data/listening-study/reviewed-aliases.json
!data/listening-study/rules.sha256
!data/listening-study/sample.json
!data/listening-study/sample.json.sha256
# Keep ignoring nested data/ directories (data/* above only matches at the repo root).
*/**/data/

# Local dotenv variants may contain credentials. Commit examples only.
.env.*
!.env.example
!.env.sample
!.env.template
